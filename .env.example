# GeoHarness Environment Variables
# Copy to .env and fill in your values

# LLM API
GEOH_MODEL=deepseek-chat
GEOH_API_KEY=your-api-key-here
GEOH_BASE_URL=https://api.deepseek.com/v1

# PostGIS Connection
GEOH_POSTGIS_DSN=postgresql://user:password@localhost:5432/geodb

# MCP Server Paths
GEOH_GEO_MCP_PATH=F:/Desktop/项目/geo-mcp-server
GEOH_QGIS_MCP_PATH=F:/Desktop/项目/qgis-mcp
GEOH_POSTGRES_MCP_PATH=F:/Desktop/项目/postgres-mcp

# Cartography Template
GEOH_DEFAULT_TEMPLATE=F:/Desktop/OpenHarness/mapping_knowledge/mapping_resources/07_制图模板库/BASE/BASE-REF_A3H.qpt

# Workspace
GEOH_WORKSPACE_ROOT=~/.geoharness/workspaces
